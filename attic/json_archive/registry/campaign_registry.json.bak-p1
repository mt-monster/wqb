    {
      "id": "GLB-EMOTION-DEAD",
      "family": "emotion 信号族 (label 含 p0q2/p1q2/q4sp/ql4/y60w15/y60L)",
      "finding": "GLB 42 个 PASS_CHEAP 全被 PROD_CORRELATION 0.82-0.86 硬闸挡掉；跨前缀/universe/中性化均失败",
      "rule": "该族在任何区域都不值得再挖；如需 emotion 方向必须先正交化或换新数据"
    },
    {
      "id": "ANL15-GLB-FO-BLOCKED",
      "family": "anl15_* 裸字段 winsorize(ts_backfill(x,120),std=4) 长历史模板",
      "finding": "GLB/TOP3000 下 8 个精确表达式稳定触发 resource 超限（精确清单见 glb_alpha_machine/cache/blocked_fields.txt）；同数据集其他字段正常",
      "rule": "封禁按精确表达式匹配，禁止按 anl15_ 前缀通杀"
    },
    {
      "id": "UNIVERSE-ILLEGAL-TIERS",
      "family": "universe 档位合法性",
      "finding": "TOP800/1500/2500/5000 全平台非法（400 拒或静默返空）",
      "rule": "只允许 TOP500/1000/2000/3000（USA 系）或各区域默认档，见各 region.static"
    }
