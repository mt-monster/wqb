+def _is_weighted_arg(arg: str) -> bool:
+    """涓€涓?add() 瀹炲弬鏄惁鈥滃甫鏄惧紡鏉冮噸鈥濓細`0.65 * 鑵縛 / `multiply(0.4, 鑵?` / `multiply(鑵? 0.5)`銆?+
+    鍙 (0,1) 寮€鍖洪棿鐨勫瓧闈㈤噺锛歚multiply(2, 鑵?`锛堟斁澶э級涓?`subtract(0, rank(x))`锛堝彇璐燂級
+    閮戒笉鏄贩鑵挎潈閲嶃€?+    """
+    a = (arg or "").strip()
+    m = _W_NUM_RE.match(a)
+    if m:
+        try:
+            return 0 < float(m.group(1)) < 1
+        except ValueError:
+            return False
+    mm = re.match(r"^multiply\s*\(", a, re.I)
+    if mm:
+        for sub in _top_level_args(a, mm.end() - 1):
+            t = sub.strip()
+            if re.fullmatch(r"\d*\.?\d+", t):
+                try:
+                    if 0 < float(t) < 1:
+                        return True
+                except ValueError:
+                    continue
+    return False
+
