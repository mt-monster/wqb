+def _top_level_args(s: str, open_idx: int) -> list:
+    """鍙?`s[open_idx] == '('` 鐨勯《灞傚疄鍙傦紙鎷彿骞宠　鍒嗗壊锛屽祵濂楅€楀彿涓嶇畻锛夈€?""
+    out, depth, cur = [], 0, ""
+    for ch in s[open_idx + 1:]:
+        if ch == "(":
+            depth += 1
+            cur += ch
+        elif ch == ")":
+            if depth == 0:
+                out.append(cur)
+                return out
+            depth -= 1
+            cur += ch
+        elif ch == "," and depth == 0:
+            out.append(cur)
+            cur = ""
+        else:
+            cur += ch
+    if cur:
+        out.append(cur)
+    return out
+
