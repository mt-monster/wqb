#!/bin/sh
# pre-commit hook — 提交前运行 pytest 验证路由（AGENTS.md §4）。
# 安装：git config core.hooksPath tools/git-hooks
#   （或将本文件复制到 .git/hooks/pre-commit 并赋予可执行权限）
# 跳过（紧急情况）：git commit --no-verify

echo "[pre-commit] running pytest validation route..."
if ! python -m pytest tests/ -x; then
    echo ""
    echo "[pre-commit] BLOCKED: pytest failed. Fix failing tests before committing."
    echo "[pre-commit] (results written to logs/test-results.xml)"
    exit 1
fi
echo "[pre-commit] pytest passed."
