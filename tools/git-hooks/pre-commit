#!/bin/sh
# pre-commit hook — 提交前运行结构守护 + pytest 验证路由（AGENTS.md §4）。
# 安装：git config core.hooksPath tools/git-hooks
#   （或将本文件复制到 .git/hooks/pre-commit 并赋予可执行权限）
# 跳过（紧急情况）：git commit --no-verify
#
# 执行顺序（五道，全为阻断位除标注）：
#   0) 解释器与依赖自检（缺 .venv / 缺 pytest・redis ⇒ BLOCKED，不退回到 PATH python）
#   1) tools/audit_structure.py      —— 结构契约 S1–S14（FAIL 阻断）
#   2) code-audit/repo_governance_check.py --warn —— 未跟踪源码（**告警位，不阻断**）
#   3) code-audit/doc_path_refs.py   —— 活文档死指针（棘轮：只拦新增，FAIL 阻断）
#   4) code-audit/audit_destructive_default.py —— 默认即破坏（棘轮：只拦新增，FAIL 阻断）
#   5) python -m pytest tests/ -x    —— 验证路由（失败阻断；skipped 不阻断但会顶屏）
#
# ⚠ 第 2 步是告警位不阻断（并行会话常态有未跟踪文件，硬卡只会逼人 --no-verify）。
#   所以「新增未跟踪源码」**不会被钩子拦住**，人工对齐不可省：
#   提交前自己跑一次 `python tools/code-audit/repo_governance_check.py`（退出码 1 = 有）。
#
# --- 解释器解析（2026-09-30 新增；2026-10-06 改为硬闸）-----------------------
# 钩子由 git 自带的 sh 执行，其 PATH 与交互式 shell 不同：实测在本机会把
# `python` 解析到 LobsterAI 运行时（无 pytest），导致钩子每次提交都误报失败。
# 规则：**只用仓库 venv 的解释器**。
# （另见 tools/_pyenv.py：网络类工具要用 MCP venv，那是另一条路径；钩子不走它。）
#
# ⚠ 为什么不再回退到 PATH python（2026-10-06 治理评审 P1-5）：回退是 fail-open 的。
# 实测 PATH 解释器缺 `redis`，于是带 `importorskip("redis")` 的守卫测试被**静默 skip**，
# 而 `pytest -x` 对 skip 返回 0 ⇒ 钩子打印「pytest passed」，真正的检查一条没跑。
# 被吞掉的是结论级守卫（瞬断重试吞 error、`ra_failed_checks` 单一定义闸等）。
# 「宁可误拦一次提交」优于「假装绿一次」。
_REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
if [ -x "$_REPO_ROOT/.venv/Scripts/python.exe" ]; then
    PY="$_REPO_ROOT/.venv/Scripts/python.exe"
elif [ -x "$_REPO_ROOT/.venv/bin/python" ]; then
    PY="$_REPO_ROOT/.venv/bin/python"
else
    echo "[pre-commit] BLOCKED: 仓库 .venv 不存在（$_REPO_ROOT/.venv）。"
    echo "[pre-commit] 不退回 PATH 解释器：那会静默 skip 掉 redis/mcp_core 类守卫测试，"
    echo "[pre-commit] 而 pytest 对 skip 返回 0 —— 钩子会假装通过。"
    echo "[pre-commit] 修法："
    echo "[pre-commit]   python -m venv .venv"
    echo "[pre-commit]   .venv/Scripts/python.exe -m pip install -r requirements.txt"
    echo "[pre-commit]   .venv/Scripts/python.exe -m pip install -r world-quant-brain-mcp/requirements.txt"
    exit 1
fi
if [ -z "$PY" ]; then
    echo "[pre-commit] BLOCKED: 找不到 python 解释器。"
    exit 1
fi

# --- 依赖自检（2026-10-06 新增）----------------------------------------------
# 闸自身的依赖到位才继续。缺依赖时不是「少跑几个测试」，而是**整类守卫被 skip**。
# 只校 requirements.txt 里声明过的依赖（不校 mcp_core：它靠 tests/conftest.py 注入 sys.path）。
if ! "$PY" -c "import pytest, redis" >/dev/null 2>&1; then
    echo "[pre-commit] BLOCKED: $PY 缺 pytest/redis 之一 —— 会有守卫测试被静默 skip。"
    echo "[pre-commit] 修法：$PY -m pip install -r requirements.txt -r world-quant-brain-mcp/requirements.txt"
    exit 1
fi

# --- pytest temp-dir redirect ---------------------------------------------
# 默认临时目录（如 C:\Users\<user>\AppData\Local\Temp\pytest-of-<user>）
# 可能残留上一次高完整性级别进程留下的 `pytest-current` 联结(junction)；
# pytest 退出清理该目录时会抛 PermissionError [WinError 5] 并阻断提交。
# 下方把临时基目录重定向到用户自有、无 junction 锁的路径，并用每次运行
# 唯一的 base temp，使 pytest 会话末不 rmtree 整棵累积树（否则会触发沙箱
# safe-delete 守卫，误判测试失败）。提交时无需再手动注入 TMPDIR。
# 注意：本沙箱 Bash 的 $TMP/$TEMP 常为空，故用 Python 取真实用户临时目录，
# 且用 mkdir -p 显式建目录（mktemp -d 在此环境只取名不建目录，不可用）。
_WQB_OS_TMP=$("$PY" -c "import tempfile; print(tempfile.gettempdir())" 2>/dev/null)
if [ -z "$_WQB_OS_TMP" ]; then
    _WQB_OS_TMP="${TMP:-${TEMP:-/tmp}}"
fi
_WQB_PYTEST_TMP="$_WQB_OS_TMP/wqb_pytest"
mkdir -p "$_WQB_PYTEST_TMP"
export TMPDIR="$_WQB_PYTEST_TMP"
export TEMP="$_WQB_PYTEST_TMP"
export TMP="$_WQB_PYTEST_TMP"
# 每次运行唯一 base temp：pytest 对 --basetemp 指定的目录在会话结束不会
# 删除（只保留/复用），彻底避免"会话末对累积的 pytest-of-<user> 整树做
# 一次性 rmtree"触发 safe-delete 守卫。各测试 tmp_path 仍在运行内按原
# 方式清理（单文件，不受影响）。
_WQB_BASETEMP="$_WQB_PYTEST_TMP/run_$(date +%s%N)_$$"
mkdir -p "$_WQB_BASETEMP"
# --------------------------------------------------------------------------

# --- 结构守护（2026-09-30 新增）---------------------------------------------
# 只读检查，不改文件。S1/S2/S4 的新增违规会阻断提交；S3/S5/S6 是存量技术债，
# 以 WARN 呈现不阻断（清理是独立任务，不应卡住日常提交）。
# 退出码：0=通过，1=有 FAIL。
if ! "$PY" tools/audit_structure.py; then
    echo ""
    echo "[pre-commit] BLOCKED: structure audit failed. See FAIL lines above."
    echo "[pre-commit] (S1/S2/S4 是硬约定；如确认是存量误报请修检查器而非绕过)"
    exit 1
fi
echo "[pre-commit] structure audit passed."

# --- 治理先行指标（2026-10-06 新增，**只告警不阻断**）------------------------
# 「未跟踪源码类文件数」= 下次 `git clean -fd` 会永久带走几个文件（它们从未进 git，
# checkout / reflog 都救不回；实证：tools/ 一次丢 17 个被文档引用的脚本）。
# 为什么**不阻断**：本机常态有多条并行会话（AGENTS.md §7），未跟踪文件是情境性的；
# 拿它卡提交只会逼人 `--no-verify`——那正是我们要避免的。真正要阻断的是
# 「新增死指针」（下方棘轮）与「真去跑 git clean」这个动作本身（AGENTS.md §7 红线）。
"$PY" tools/code-audit/repo_governance_check.py --warn || true

# --- 活文档路径引用（2026-10-06 新增，**棘轮：只拦新增**）--------------------
# 文档写了某个路径、而它既不在 git 也不在磁盘 → 文档腐烂，或又一批丢失件。
# 只对**新增**违规 FAIL（存量登记在 tests/fixtures/doc_path_refs_baseline.json），
# 因此历史债务不会卡住日常提交。
if ! "$PY" tools/code-audit/doc_path_refs.py; then
    echo ""
    echo "[pre-commit] BLOCKED: 活文档引用了不可达路径（新增死指针）。"
    echo "[pre-commit] 修法：① 改文档指向真实路径 ② 恢复丢失文件 ③ 归档到 attic 并在文中写明"
    echo "[pre-commit]       ④ 若引用确实合理（如 TWN 这类未初始化区域的模板引用），"
    echo "[pre-commit]          跑 python tools/code-audit/doc_path_refs.py --update-baseline 登记。"
    exit 1
fi
echo "[pre-commit] doc path refs passed."

# --- 默认即破坏（2026-10-06 新增，**棘轮：只拦新增**）-------------------------
# 模块级（import 时就会跑的）写盘 / 删除调用，且"提前退出型开关"在其**后面** ⇒
# 任何一次误调用（历史上就发生过：跑一次 `--help` 把被跟踪的 2808 行文件截成 91 行）
# 都会真落盘。棘轮语义同 doc_path_refs：存量登记在
# tests/fixtures/destructive_default_baseline.json，只拦新增。
if ! "$PY" tools/code-audit/audit_destructive_default.py; then
    echo ""
    echo "[pre-commit] BLOCKED: 新增了『默认即破坏』的模块级破坏性调用。"
    echo "[pre-commit] 修法：① 调用前放默认干跑闸（--apply 才落盘）"
    echo "[pre-commit]       ② 把破坏性动作收进 def main() + if __name__ == \"__main__\" 守卫"
    echo "[pre-commit]       ③ 复核确认是合理存量债 → python tools/code-audit/audit_destructive_default.py --update-baseline"
    exit 1
fi
echo "[pre-commit] destructive-default audit passed."

# --- pytest -----------------------------------------------------------------
echo "[pre-commit] running pytest validation route..."
# 输出先落文件再 cat：POSIX sh 没有 PIPESTATUS，`cmd | tee` 会把退出码变成 tee 的，
# 于是「pytest 红了也拦不住」。重定向 + 回显既能拿退出码又不断人看输出。
_PYTEST_LOG="$_WQB_PYTEST_TMP/pre-commit_pytest_$$.log"
if ! "$PY" -m pytest tests/ -x "--basetemp=$_WQB_BASETEMP" > "$_PYTEST_LOG" 2>&1; then
    cat "$_PYTEST_LOG"
    echo ""
    echo "[pre-commit] BLOCKED: pytest failed. Fix failing tests before committing."
    echo "[pre-commit] (results written to logs/test-results.xml)"
    rm -f "$_PYTEST_LOG"
    exit 1
fi
cat "$_PYTEST_LOG"
# 2026-10-06 治理评审：skip 不是 pass。环境耦合的 `needs_*` skip 是设计内（AGENTS.md §4），
# 但**模块内 `importorskip("redis")` 这类 skip 意味着守卫没跑**。不阻断（误伤面大），
# 但必须把数字顶到屏幕上，让提交的人知道本轮到底执行了多少。
if grep -qE "skipped" "$_PYTEST_LOG"; then
    echo "[pre-commit] NOTE: 本轮有 skipped 用例——它们**没有执行**。"
    echo "[pre-commit]       若 skip 出现在已声明依赖上（redis / mcp_core / score_datasets），"
    echo "[pre-commit]       那就是闸失效，必须查因：python -m pytest tests/ -q -rs"
fi
rm -f "$_PYTEST_LOG"
echo "[pre-commit] pytest passed."
