#!/usr/bin/env python3
"""MCP 工具调用辅助脚本 - 处理 session 管理和 SSE 解析"""
import json, sys, urllib.request, urllib.error

URI = 'http://127.0.0.1:8876/mcp'
SESS_FILE = r'D:\coding\traeCN_project\wqb\wqb-share-03\tracking\.mcp_session'

def new_session():
    body = json.dumps({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"py","version":"1.0"}}}).encode()
    req = urllib.request.Request(URI, data=body, headers={'Content-Type':'application/json','Accept':'application/json, text/event-stream'})
    resp = urllib.request.urlopen(req, timeout=1800)
    sid = resp.headers.get('mcp-session-id')
    if not sid:
        raise RuntimeError("no mcp-session-id header")
    # notifications/initialized
    notif = json.dumps({"jsonrpc":"2.0","method":"notifications/initialized"}).encode()
    req2 = urllib.request.Request(URI, data=notif, headers={'Content-Type':'application/json','Accept':'application/json, text/event-stream','mcp-session-id':sid})
    try:
        urllib.request.urlopen(req2, timeout=30)
    except:
        pass
    with open(SESS_FILE, 'w') as f:
        f.write(sid)
    return sid

def call_tool(tool_name, arguments, sid=None, timeout=1800):
    if sid is None:
        try:
            with open(SESS_FILE) as f:
                sid = f.read().strip()
        except:
            sid = new_session()
    body = json.dumps({"jsonrpc":"2.0","id":999,"method":"tools/call","params":{"name":tool_name,"arguments":arguments}}).encode()
    req = urllib.request.Request(URI, data=body, headers={'Content-Type':'application/json','Accept':'application/json, text/event-stream','mcp-session-id':sid})
    try:
        resp = urllib.request.urlopen(req, timeout=timeout)
    except urllib.error.HTTPError as e:
        # session stale, retry
        sid = new_session()
        req = urllib.request.Request(URI, data=body, headers={'Content-Type':'application/json','Accept':'application/json, text/event-stream','mcp-session-id':sid})
        resp = urllib.request.urlopen(req, timeout=timeout)
    content = resp.read().decode()
    # parse SSE
    result = None
    for line in content.splitlines():
        if line.startswith('data: '):
            result = json.loads(line[6:])
    if result and 'result' in result:
        text = ''.join(c.get('text','') for c in result['result'].get('content',[]))
        if result['result'].get('isError'):
            return {'error': text}
        try:
            return json.loads(text)
        except:
            return {'raw': text}
    return result

if __name__ == '__main__':
    tool = sys.argv[1]
    args = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
    result = call_tool(tool, args)
    print(json.dumps(result, ensure_ascii=False, indent=1, default=str))