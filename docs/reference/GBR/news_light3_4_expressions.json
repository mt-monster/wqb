  "W12": "ts_target_tvr_decay(group_zscore(-ts_corr(vec_avg(nws18_nip), vec_avg(sentiment_composite_score_d1), 22), densify(market)), target_tvr=0.05, lambda_max=5, lambda_min=0)"
