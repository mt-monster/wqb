  "W4": "ts_target_tvr_decay(group_neutralize(ts_corr(vec_sum(sentiment_earnings_classifier_d1), returns, 22), densify(market)), target_tvr=0.05, lambda_max=5, lambda_min=0)",
  "W5": "ts_target_tvr_decay(group_neutralize(ts_corr(vec_sum(sentiment_m_and_a_classifier), returns, 60), densify(market)), target_tvr=0.05, lambda_max=5, lambda_min=0)",
  "W6": "ts_target_tvr_decay(group_neutralize(-ts_rank(ts_mean(vec_sum(sentiment_earnings_release_classifier), 60), 252), densify(market)), target_tvr=0.05, lambda_max=5, lambda_min=0)",
  "W7": "ts_target_tvr_decay(group_neutralize(-ts_rank(ts_mean(vec_avg(story_entity_record_count_d1), 22), 252), densify(market)), target_tvr=0.05, lambda_max=5, lambda_min=0)",
  "W8": "ts_target_tvr_decay(group_neutralize(-ts_rank(ts_delta(ts_mean(vec_avg(multi_entity_story_event_count), 22), 60), 252), densify(market)), target_tvr=0.05, lambda_max=5, lambda_min=0)",
  "W9": "ts_target_tvr_decay(group_neutralize(-ts_rank(ts_mean(vec_min(sentiment_composite_score_d1), 22), 252), densify(market)), target_tvr=0.05, lambda_max=5, lambda_min=0)",
  "W10": "ts_target_tvr_decay(group_neutralize(subtract(rank(ts_mean(vec_avg(sentiment_commentary_classifier), 60)), rank(ts_mean(vec_stddev(sentiment_commentary_classifier), 60))), densify(market)), target_tvr=0.05, lambda_max=5, lambda_min=0)",
