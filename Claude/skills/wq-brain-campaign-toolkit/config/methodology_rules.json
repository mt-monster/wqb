   "rule_id": "prod_wall_dilution_v1",
   "type": "strategy",
   "trigger": {
    "condition": "is_strong AND prod_corr > 0.7",
    "region": "*",
    "dataset_type": "value"
   },
   "action": {
    "op": "gradient_dilute",
    "params": {
     "corr_threshold": 0.3,
     "weight_step": 0.1,
     "tool": "compute_mutual_correlation"
    },
    "message": "IS 强但 prod_corr>0.7 撞墙时：先用 compute_mutual_correlation 找 |corr|<0.3 的低相关分量，再梯度稀释（步长 0.1）定位 prod<0.7 甜点。"
   },
   "evidence": {
    "campaign": "EUR",
    "wave": "wave6c",
    "prod_curve": {
