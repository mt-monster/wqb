  "volatility": "波动率类（volatility/std/realized_vol 等）",
  "valuation": "估值类（pe/pb/ps/enterprise_value 等）",
  "fundamental": "基本面类（earnings/sales/bookvalue/cashflow 等）",
  "sentiment": "情绪/舆情类（news_sentiment/social_score 等）",
  "analyst": "分析师预期类（estimate/revision/target 等）",
  "signal_any": "任意有数值意义的信号字段（兜底角色）",
  "group": "分组键（sector/industry/country/market_cap_bucket 等，用于 group_*）",
  "window": "时间窗口整数（5/10/20/60/120/252 等）",
  "scalar": "常数标量（0.5/2 等）"
