attic/

# Skills mirror (local sync copy, not project code)
.qoder-cn/

# temp commit-message files (never commit)
logs/_commit_msg.txt
# one-off probe/verify scripts + their output dumps (tmp by convention; archive to attic/ before purge)
logs/_tmp_*

# SuperAlpha API result dumps (runtime artifacts, never commit)
world-quant-brain-mcp/super_alpha_result_*.json

# Windows reserved device name: some external command redirects logs with `> nul`,
# which silently creates a real file named `nul` in the repo root. It keeps coming
# back (regenerated by a long-running process), so ignore it rather than chase it.
/nul
